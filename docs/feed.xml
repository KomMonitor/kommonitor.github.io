---
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }} – Release Info</title>
    <description>Aktuelle Release-Informationen für KomMonitor</description>
    <link>{{ site.url }}/releases/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <language>de</language>
    {% assign releases = site.data.releases | sort: "date" | reverse %}
    {% for release in releases limit: 20 %}
    <item>
      <title>{{ release.component | xml_escape }} {{ release.version | xml_escape }}</title>
      <link>{{ site.url }}{{ release.page }}#{{ release.anchor }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ release.page }}#{{ release.anchor }}</guid>
      <description>{{ release.summary | xml_escape }}</description>
      <pubDate>{{ release.date | date_to_rfc822 }}</pubDate>
    </item>
    {% endfor %}
  </channel>
</rss>
